# Required session-signing secret. Generate a unique value for each installation:
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# API integrations. Search requires the relevant provider's credentials.
YELP_KEY=
SPOON_API_KEY=
GOOGLE_API_KEY=
# Optional separate restaurant-description key; defaults to GOOGLE_API_KEY.
GENAI_KEY=
GEOAPIFY_KEY=

# Optional overrides. Default database is preprn.db in the project directory.
# PREPRN_DATABASE_PATH=/absolute/path/to/preprn.db
# SESSION_COOKIE_SECURE=true
